<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Third-party dependency licences</title>
<style>
  body { font-family: sans-serif; max-width: 900px; margin: 2em auto; padding: 0 1em; color: #111; }
  h1 { font-size: 1.4em; }
  h2 { border-bottom: 1px solid #ccc; padding-bottom: .3em; margin-top: 2em; font-size: 1.1em; }
  pre { white-space: pre-wrap; word-wrap: break-word; background: #f6f6f6; padding: 1em;
        border: 1px solid #ddd; font-size: .85em; }
  .used-by { font-size: .9em; color: #444; }
  .intro { font-size: .95em; color: #333; }
  .packaged-license { margin-top: 2em; }
  .packaged-license h3 { margin-bottom: .25em; }
  .packaged-license h4 { margin-bottom: .25em; font-family: monospace; }
  .package-authors { margin-top: 0; font-size: .9em; color: #444; }
</style>
</head>
<body>
<h1>Third-party Rust dependency licences</h1>
<p class="intro">
  Generated by <code>cargo about</code> from this build's locked dependency graph
  (<code>packaging/generate-dependency-licenses.ps1</code>). This is the notice text
  itself; see <code>THIRD_PARTY_NOTICES.md</code> in the source repository for the
  human-readable overview and the licences of the application's own code and its
  non-Rust bundled components.
</p>
<p class="intro">
  The exact licence, notice, copyright, and authorship files packaged by each dependency
  that supplies them are appended below by the generator. Those verbatim files are
  authoritative when a normalized SPDX text above contains placeholders or omits a
  package-specific notice.
</p>
{{#each licenses}}
<h2>{{this.name}} ({{this.id}})</h2>
<p class="used-by">Used by:
{{#each this.used_by}}{{this.crate.name}} {{this.crate.version}}{{#unless @last}}, {{/unless}}{{/each}}
</p>
<pre>{{this.text}}</pre>
{{/each}}
</body>
</html>
