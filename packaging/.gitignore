/staging/

# Built release artifacts: the package (-setup.exe, .deb or .pkg.tar.xz) and the GPLv3
# corresponding-source zip that must be published beside it. Do not commit.
/dist/

# build_corresponding_source.py's scratch tree. It removes it after zipping, but a run that
# fails partway leaves it behind - thousands of espeak-ng files `git add -A` would sweep in.
/corresponding-source-*/

# Generated by generate_dependency_licenses.py from the current Cargo.lock files -
# provisioned, not tracked, same reasoning as native-deps/windows/runtime/notices/.
/dependency-licenses/
