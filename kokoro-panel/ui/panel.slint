import { Button, ComboBox, Slider, CheckBox, Switch, ProgressIndicator, Palette } from "std-widgets.slint";

// A labelled slider row: title on the left, live value on the right, slider below.
component SliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <bool> enabled: true;
    in-out property <float> value;
    callback changed(float);
    // Scratch: the current drag value snapped to `step`. Compared against `value`
    // so we only commit/persist on a real step change (see the Slider below).
    property <float> snapped;
    spacing: 3px;
    // Dim the whole row (label + readout + slider) when disabled.
    opacity: root.enabled ? 1.0 : 0.5;
    HorizontalLayout {
        Text { text: root.label; font-size: 15px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.value-text; font-size: 15px; color: #7a7a7a; vertical-alignment: center; }
    }
    Slider {
        enabled: root.enabled;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value: root.value;
        // A drag fires `changed` per pixel; Slint's `step` only snaps keyboard/
        // scroll, not the drag. Snap the value ourselves and only propagate when
        // the snapped step actually changes — otherwise every sub-step mouse move
        // would re-set the value and re-write controls.json to disk (on the UI
        // thread), which makes the slider stutter and feel unresponsive.
        changed(v) => {
            root.snapped = root.step > 0
                ? root.minimum + Math.round((v - root.minimum) / root.step) * root.step
                : v;
            if root.snapped != root.value {
                root.value = root.snapped;
                root.changed(root.snapped);
            }
        }
    }
}

// A square icon button: a Material Symbols glyph inside a rounded-square border,
// both tinted with `accent`. Hover brightens the glyph and border and gives the
// box a faint accent fill; disabled dims the whole thing and greys the glyph.
// PlayButton / StopButton below are thin instances that set the icon + accent.
// The forwarded @children (a Tooltip) rides on top.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> accent: Palette.accent-background;
    in property <bool> enabled: true;
    callback clicked;

    width: 34px;
    height: 34px;
    opacity: root.enabled ? 1.0 : 0.5;

    // Rounded-square outline in the accent (primary) color; picks up a faint
    // accent fill on hover.
    border-radius: 8px;
    border-width: 1px;
    border-color: !root.enabled
        ? Palette.border
        : (touch.has-hover ? root.accent.brighter(0.2) : root.accent);
    background: (root.enabled && touch.has-hover) ? root.accent.transparentize(0.88) : transparent;
    animate border-color, background { duration: 130ms; }

    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // Idle == the accent exactly (matches the sliders); hover brightens.
        colorize: !root.enabled
            ? #888888
            : (touch.has-hover ? root.accent.brighter(0.2) : root.accent);
        animate colorize { duration: 130ms; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    @children
}

// Preview: start playback. Google Material Symbols play_arrow (Rounded), theme
// accent (same blue as the sliders).
component PlayButton inherits IconButton {
    icon: @image-url("play-arrow.svg");
    accent: Palette.accent-background;
}

// Resume Kindle's reading. Google Material Symbols resume (Rounded) with the left
// bar lengthened past the triangle at both ends, Tiffany blue.
component ResumeButton inherits IconButton {
    icon: @image-url("resume.svg");
    accent: #0abab5;
}

// Pause Kindle's reading. Google Material Symbols pause (Rounded), amber.
component PauseButton inherits IconButton {
    icon: @image-url("pause.svg");
    accent: #f5a623;
}

// Preview: stop playback. Google Material Symbols stop (Rounded), red.
component StopButton inherits IconButton {
    icon: @image-url("stop.svg");
    accent: #ff4a3d;
}

// Run the GPU-vs-CPU speed test. Google Material Symbols sprint (Rounded), theme accent
// — a runner reads as "which of these is faster" without a word of label.
component SprintButton inherits IconButton {
    icon: @image-url("sprint.svg");
    accent: Palette.accent-background;
}

// A hover-for-help "?" that carries a control's explanation instead of spending three
// permanent lines of the panel on it. Drawn rather than imported: at 18px a Material glyph
// is mostly padding, and a circled question mark is the one icon nobody has to learn.
//
// Deliberately NOT an IconButton. It is the same size and shape as one, and that would read
// as a second button next to the sprint runner — but there is nothing to click, so the
// cursor is `help` and the styling stays at body-text weight so it reads as punctuation
// after the label. Give it a `Tooltip` child; that is the entire point of it.
//
// It has NO `enabled` and never dims with the control it explains. Everything else in the
// row goes dark together, and this deliberately doesn't: the question it answers ("what is
// this, and why can't I click it?") is asked most often precisely when the control is
// disabled, so an inert help icon withholds the answer at the one moment it's wanted. Dimming
// it while its tooltip still fired was the worse of the two — it looked spent and wasn't.
component HelpIcon inherits Rectangle {
    // Plain width/height and x/y-centred content, exactly as `IconButton` above does it.
    // `min-height`/`max-height` did NOT hold here — the row stretched it into a tall pill —
    // so copy the pattern that visibly works in this same layout rather than the one that
    // ought to. `border-radius` is half the side, so the shape is a circle by construction:
    // if the size ever changes, change both.
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: touch.has-hover ? #a0a0a0 : #6a6a6a;
    animate border-color { duration: 130ms; }
    Text {
        text: "?";
        font-size: 11px;
        font-weight: 700;
        color: touch.has-hover ? #d0d0d0 : #a0a0a0;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        animate color { duration: 130ms; }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.help;
    }
    @children
}

// The shared chrome for the panel's modal dialogs: a full-window scrim that swallows
// clicks on everything beneath, with a raised card centred on top. The card takes the
// height its content negotiates (nested centering layouts, not hand-computed x/y), so
// wrapped text can never push the buttons past its edge. @children land in the card's
// padded column — a dialog supplies only its own content.
component ModalCard inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #00000099; // heavy scrim so the card clearly floats above the panel
    TouchArea { } // modal: swallow clicks on everything beneath
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: Math.min(root.width - 48px, 340px);
                // Raised surface: a foreground tint over the window background reads
                // as elevation in both themes (same trick as the model status card).
                background: Palette.background.mix(Palette.foreground, 0.92);
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                drop-shadow-blur: 32px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #00000080;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    @children
                }
            }
        }
    }
}

// One measured engine in the speed-test results: name on the left, its realtime factor
// on the right. The winner is bold Lawn Green — the same green as the Waveform and the
// "Voice Engine Ready" readout, so "good" reads the same everywhere in the panel; the
// loser (or an engine that couldn't run) stays grey, making the verdict legible at a
// glance without reading the numbers.
component BenchRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> won;
    spacing: 8px;
    Text { text: root.label; font-size: 14px; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.value;
        font-size: 14px;
        font-weight: root.won ? 700 : 400;
        color: root.won ? #7cfc00 : #7a7a7a; // Lawn Green
        vertical-alignment: center;
    }
}

// A tiny animated voice meter: six rounded bars that ripple up and down like an
// audio equalizer. Driven by `animation-tick()`, so it animates only while it's on
// screen (the "ready" state) and costs nothing otherwise. Each bar is phase-offset
// from its neighbour, giving a travelling-wave look.
component Waveform inherits Rectangle {
    min-width: 48px;
    max-width: 48px;
    min-height: 20px;
    max-height: 20px;
    // Bar colour follows its height: a short bar sits at the base green, a tall one
    // lifts toward a light green (mix factor = weight of `lo`, so 1 = short/lo).
    property <color> lo: #2e8b40;
    property <color> hi: #7cfc00; // Lawn Green
    for _bar[i] in [0, 1, 2, 3, 4, 5]: Rectangle {
        width: 4px;
        x: i * 7px;
        // 1.3 cycles/sec, each bar 52° behind the last → a rolling wave.
        height: 5px + 13px * (1 + Math.sin(animation-tick() / 1s * 468deg + i * 52deg)) / 2;
        y: parent.height - self.height;
        border-radius: 2px;
        background: root.lo.mix(root.hi, 1.0 - (self.height - 5px) / 13px);
    }
}

export component AppWindow inherits Window {
    title: "Kokoro Kindle Reader — Settings";
    icon: @image-url("../../icons/128x128.png");
    default-font-size: 15px;
    preferred-width: 400px;
    preferred-height: 600px;
    // Floor of the narrator row: accent (120) + gender (100) + name (100 min before
    // its chevron clips) + 16 spacing + 40 padding (symmetric 20px each side), with
    // the remainder as slack. Narrower and the chevron spills.
    min-width: 400px;

    // --- state (set from Rust) ---
    // Narrator as three cascading dropdowns: accent x gender selects the name list.
    in property <[string]> accents;
    in property <[string]> genders;
    in property <[string]> names;
    in-out property <int> accent-index;
    in-out property <int> gender-index;
    in-out property <int> name-index;
    in-out property <float> speed;
    in-out property <float> gain;
    in-out property <float> chunk;
    in-out property <bool> kindle-kokoro;
    in-out property <bool> gpu-synth; // GPU (default) vs CPU engine; no auto-detect yet
    // The three reading-state properties below are REPORTED BY THE HOST (CMD_KINDLE), not
    // decided here: the panel sends Play/Stop/Pause/Resume as intent and draws what comes
    // back. It never inspects Kindle itself.
    in-out property <bool> reading;   // the host believes Kindle's Assistive reader is on
    in property <bool> speaking;      // Kokoro is narrating Kindle now (or Preview is playing)
    in-out property <bool> paused;    // playback stalled mid-page (host-owned live state)
    // Is the tray host answering? Polled at ~1 Hz over the pipe; an unreachable pipe is
    // what "offline" means. Everything that needs the host is dark while this is false —
    // an offline host must never look like one that applied the command.
    in property <bool> host-online;
    // Set when the Read Aloud switch is flipped and cleared once the host's own report shows
    // the flip landed (`Settling` in main.rs) — not on a timer, which could only guess at a
    // duration the host actually knows. Stops a second flip stacking another multi-second
    // Kindle command on top of the one still running.
    in property <bool> read-aloud-locked;
    // Is Kindle running at all? Also the host's answer (it's the process that looks). A
    // Read Aloud switch with no reader behind it can only fail, so it says so instead.
    in property <bool> kindle-running;
    in property <bool> model-ready;
    in property <string> model-size-label; // "~340 MB", computed from the manifest sum
    in property <bool> downloading;
    in property <float> download-frac;
    in property <string> download-label;
    in property <bool> verifying;
    in property <float> verify-frac;
    in property <bool> previewing;
    in property <string> status;
    // Confirmation for the Kindle-narration toggle: the flag only lands on Kindle's
    // next launch, so confirming also closes Kindle. `confirm-target` is the desired
    // new value, held (unpersisted) while the dialog is up.
    in-out property <bool> confirm-visible;
    in property <bool> confirm-target;
    // GPU-vs-CPU speed test. One dialog with three faces — ask, running, results —
    // selected by these two flags (neither set = the opening "ask" face).
    in-out property <bool> bench-visible;
    in property <bool> bench-running;
    in property <bool> bench-done;
    in property <string> bench-phase;    // which engine is being timed right now
    in property <string> bench-gpu-text; // "1.9x real time" / "unavailable"
    in property <string> bench-cpu-text;
    in property <bool> bench-gpu-wins;
    in property <bool> bench-cpu-wins;
    in property <string> bench-verdict;  // what was measured and what got selected

    // ONE gate for narration controls below the Kindle-narration checkbox — narrator, sliders,
    // transport, engine picker, speed test. They light up together and go dark together.
    //
    // `host-online` is in here even for the settings. The narrator and sliders would
    // technically still save to controls.json with the host down, but a live-looking
    // slider whose value nothing can read is a control claiming an effect it can't have,
    // and it invites fiddling instead of reading the one red line above that says what's
    // actually wrong. `kindle-kokoro` likewise: with narration off there is nothing left
    // down here for a setting to affect.
    property <bool> controls-active: root.model-ready && !root.downloading && !root.verifying
        && root.host-online && root.kindle-kokoro;
    // Starting/stopping Kindle's reader needs a Kindle as well as a host.
    property <bool> reading-active: root.controls-active && root.kindle-running;
    // The speed-test dialog's opening face: nothing has been run yet.
    property <bool> bench-ask: !root.bench-running && !root.bench-done;

    // --- events (handled in Rust) ---
    callback accent-changed(int);
    callback gender-changed(int);
    callback name-changed(int);
    callback speed-changed(float);
    callback gain-changed(float);
    callback chunk-changed(float);
    callback gpu-synth-changed(bool);
    callback download-clicked();
    callback kindle-toggled(bool);
    callback preview-clicked();
    callback stop-clicked();
    callback read-aloud-clicked(bool); // desired state (the switch's new value)
    callback pause-toggled(bool);      // desired paused state
    callback confirm-kindle(bool);     // dialog verdict: true = apply + close Kindle
    callback bench-open();             // show the speed-test dialog (nothing runs yet)
    callback bench-start();            // run the test
    callback bench-stop();             // stop after the engine currently being timed
    callback bench-close();
    callback legal-open();

    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        alignment: start;

        // Model status card — a subtle surface that adapts to the light/dark theme
        // (a faint tint of the foreground over the window background).
        Rectangle {
            background: Palette.foreground.transparentize(0.94);
            border-radius: 2px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                if root.downloading: VerticalLayout {
                    spacing: 8px;
                    Text { text: root.download-label; font-size: 14px; }
                    ProgressIndicator { progress: root.download-frac; height: 6px; }
                }
                // Startup integrity check: a determinate bar of how much of the
                // model/voice data has been hashed so far.
                if !root.downloading && root.verifying: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Checking model files — \{Math.round(root.verify-frac * 100)}%";
                        font-size: 14px;
                    }
                    ProgressIndicator { progress: root.verify-frac; height: 6px; }
                }
                if !root.downloading && !root.verifying && !root.model-ready: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Model not downloaded (\{root.model-size-label}).";
                        color: #b0701a;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button { text: "Download"; primary: true; clicked => { root.download-clicked(); } }
                }
                // Host down. The model is there but nothing can speak, so say exactly that
                // and name the thing to start — "offline" on its own tells the user nothing
                // they can act on. Takes the ready row's place rather than sitting beside
                // it: two status lines, one green, would be worse than none.
                if !root.downloading && !root.verifying && root.model-ready && !root.host-online: Text {
                    text: "Kokoro host offline - start Kokoro Kindle Reader.";
                    color: #ff4a3d;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if !root.downloading && !root.verifying && root.model-ready && root.host-online: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Waveform { }
                    Text {
                        // Doubles as the live "Kokoro is speaking now" readout: the host
                        // reports it on the heartbeat (CMD_KINDLE), and the same green
                        // equalizer is already animating, so we just retitle it.
                        text: root.speaking ? "Speaking" : "Voice Engine Ready";
                        color: #7cfc00; // Lawn Green
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Kindle narration toggle.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            CheckBox {
                // Drives auto-injection: the host's Kindle-watcher reads this flag
                // (kindle_kokoro in controls.json) and injects the Kokoro hook on Kindle's
                // next launch. Two-way (<=>) keeps property and widget in sync.
                text: "Narrate Kindle with Kokoro";
                checked <=> root.kindle-kokoro;
                toggled => { root.kindle-toggled(self.checked); }
            }
        }

        // Start/stop Kindle's Read Aloud (its "Assistive reader" toggle), as a switch that
        // mirrors Kindle's own control. Flipping it sends the intent to the host, which is
        // the only process that touches Kindle; the handler then writes back the state the
        // host reports (so it self-corrects if the command failed, and if Read Aloud was
        // toggled inside Kindle directly the heartbeat brings that back too).
        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Read Aloud";
                    font-size: 15px;
                    vertical-alignment: center;
                    opacity: root.reading-active ? 1.0 : 0.5;
                }
                Switch {
                    checked <=> root.reading;
                    enabled: root.reading-active && !root.read-aloud-locked;
                    toggled => { root.read-aloud-clicked(self.checked); }
                }
            }
            // Only when everything else is in place — otherwise the model card or the
            // offline line above is already saying the more useful thing.
            if root.controls-active && !root.kindle-running: Text {
                text: "Kindle isn't open.";
                font-size: 12px;
                color: #a0a0a0;
                wrap: word-wrap;
            }
        }

        // Playback transport — one context-dependent button at a time:
        //   Read Aloud OFF (not reading): Preview the narrator. Play to audition;
        //     while it plays, Stop replaces Play.
        //   Read Aloud ON  (reading):     Pause / Resume Kindle's reading mid-page
        //     (pause-toggled sends the intent to the host, which owns the flag and
        //     stalls its audio stream so Kindle keeps the page). Pause while playing;
        //     once paused, Resume replaces Pause.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if !root.reading && !root.previewing: PlayButton {
                enabled: root.controls-active;
                clicked => { root.preview-clicked(); }
                // Label lives in a hover tooltip. Tooltip.text is styled-text,
                // so wrap the literal in @markdown.
                Tooltip { text: @markdown("Preview voice"); }
            }
            if !root.reading && root.previewing: StopButton {
                enabled: root.controls-active;
                clicked => { root.stop-clicked(); }
                Tooltip { text: @markdown("Stop preview"); }
            }
            if root.reading && !root.paused: PauseButton {
                enabled: root.controls-active;
                clicked => { root.pause-toggled(true); }
                Tooltip { text: @markdown("Pause"); }
            }
            if root.reading && root.paused: ResumeButton {
                enabled: root.controls-active;
                clicked => { root.pause-toggled(false); }
                Tooltip { text: @markdown("Resume"); }
            }
        }

        // Narrator: accent x gender -> name, all three on one row.
        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Narrator";
                font-size: 15px;
                vertical-alignment: center;
                opacity: root.controls-active ? 1.0 : 0.5; // dim heading with its dropdowns
            }
            HorizontalLayout {
                spacing: 8px;
                // Accent / gender are short — size them to content; the name list
                // takes the remaining width.
                ComboBox {
                    model: root.accents;
                    current-index <=> root.accent-index;
                    enabled: root.controls-active;
                    width: 120px;
                    selected => { root.accent-changed(self.current-index); }
                }
                ComboBox {
                    model: root.genders;
                    current-index <=> root.gender-index;
                    enabled: root.controls-active;
                    width: 100px;
                    selected => { root.gender-changed(self.current-index); }
                }
                ComboBox {
                    model: root.names;
                    current-index <=> root.name-index;
                    enabled: root.controls-active;
                    horizontal-stretch: 1;
                    min-width: 100px;
                    selected => { root.name-changed(self.current-index); }
                }
            }
        }

        // Sliders
        SliderRow {
            label: "Reading Speed";
            value-text: "\{Math.round(root.speed * 100)}%";
            minimum: 0.5;
            maximum: 2.0;
            step: 0.10; // 10% increments
            enabled: root.controls-active;
            value <=> root.speed;
            changed(v) => { root.speed-changed(v); }
        }
        SliderRow {
            label: "Volume";
            value-text: "\{Math.round(root.gain * 100)}%";
            minimum: 0.0;
            maximum: 2.0;
            step: 0.10; // 10% increments
            enabled: root.controls-active;
            value <=> root.gain;
            changed(v) => { root.gain-changed(v); }
        }
        SliderRow {
            label: "Sentences per chunk";
            value-text: "\{Math.round(root.chunk)}";
            minimum: 1.0;
            maximum: 8.0;
            step: 1.0;
            enabled: root.controls-active;
            value <=> root.chunk;
            changed(v) => { root.chunk-changed(v); }
        }

        // GPU (default, ticked) vs CPU engine: an integrated GPU can lose badly to
        // plain CPU (no auto-detection yet — see native_synth.rs's Engine).
        // Which one wins isn't something a reader can be expected to know, and it can't
        // be inferred from the hardware name either — hence "Test speed", which measures
        // both here and ticks the winner.
        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: "Synthesize on GPU";
                checked <=> root.gpu-synth;
                enabled: root.controls-active;
                toggled => { root.gpu-synth-changed(self.checked); }
            }
            // The explanation used to sit permanently under this row. It's on the "?" now:
            // it answers a question asked once, and it was costing three lines of the
            // panel's height on every launch after that.
            //
            // Wrapped in a centring VerticalLayout (the same nested-layout trick `ModalCard`
            // uses) because the row is as tall as the 34px sprint button, and a fixed-size
            // child of a HorizontalLayout sits at the TOP of that, not beside the checkbox
            // it belongs to. Negotiate the position with a layout rather than hand-computing
            // a `y` against a neighbour's height.
            VerticalLayout {
                alignment: center;
                HelpIcon {
                    // Custom content rather than `text:`, because Tooltip's text mode has
                    // nothing to style with — it takes styled-text and renders it at the
                    // default size and colour. Omitting `text` and giving it exactly one
                    // root child switches it to custom mode, where this is an ordinary
                    // Text. Same 13px/#a0a0a0 as the panel's footnote below, so an aside
                    // reads as an aside wherever it turns up.
                    Tooltip {
                        VerticalLayout {
                            padding: 4px;
                            Text {
                                text: "Untick to synthesize on the CPU instead — often faster on laptops with no discrete GPU. Not sure? The runner times both and picks.";
                                font-size: 13px;
                                color: #a0a0a0;
                                wrap: word-wrap;
                                // Load-bearing: nothing else constrains a tooltip's width,
                                // so without it the whole sentence lays out on one line and
                                // runs off the side of the window.
                                max-width: 260px;
                            }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            SprintButton {
                // `controls-active` already includes the heartbeat — the test runs on the
                // host's synth worker, so there'd be nothing to time without it.
                enabled: root.controls-active;
                clicked => { root.bench-open(); }
                Tooltip { text: @markdown("Test which is faster"); }
            }
        }

        // No spacer here. There used to be a `Rectangle { vertical-stretch: 1; }` meaning to
        // push these last two lines to the foot of the window, but the layout above is
        // `alignment: start`, which hands every child its preferred size and distributes
        // nothing — so it stretched to 0px and the slack ended up *below* the footnote
        // instead. All it actually bought was a second 16px spacing slot, doubling the gap
        // under the GPU row for no visible benefit. If the footer ever should be pinned to
        // the bottom, the alignment is the thing to change, not a spacer under it.
        if root.status != "": Text {
            text: root.status;
            font-size: 14px;
            color: #5a5a5a;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Keep Kokoro Kindle Reader running (tray) for Kindle to narrate.";
                font-size: 13px;
                color: #a0a0a0;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            // Legal notices stay available with no model, host or Kindle.
            Button {
                text: "About & licenses";
                clicked => { root.legal-open(); }
            }
        }
    }

    // Modal Yes/No for the Kindle-narration toggle (declared after the main layout so
    // it draws on top). Yes applies the flag and closes Kindle; No reverts the checkbox.
    if root.confirm-visible: ModalCard {
        Text {
            text: root.confirm-target
                ? "Narrate Kindle with Kokoro?"
                : "Switch Kindle back to its own voice?";
            font-size: 15px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: "Kindle will be closed so the change takes effect. Reopen it to continue reading.";
            font-size: 14px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: "Yes";
                primary: true;
                clicked => { root.confirm-kindle(true); }
            }
            Button {
                text: "No";
                clicked => { root.confirm-kindle(false); }
            }
        }
    }

    // GPU-vs-CPU speed test. Three faces in one card: what the test does, progress while
    // it runs, then the two measurements with the winner already ticked.
    //
    // Every element is a DIRECT child of the card, each with its own `if`, rather than
    // three tidy per-face VerticalLayouts. Grouping them cost the card its height: the
    // button row, two layouts deep, didn't reach the card's size calculation and drew
    // below its bottom edge, over the panel. Keep new rows flat.
    if root.bench-visible: ModalCard {
        Text {
            text: "Which is faster on this PC?";
            font-size: 15px;
            font-weight: 600;
            wrap: word-wrap;
        }

        // Ask — nothing has run yet.
        if root.bench-ask: Text {
            text: "Kokoro will speak the same short sentence twice — once on the graphics card, once on the processor — and time each. Nothing is played aloud, and the faster one is selected for you.";
            font-size: 14px;
            wrap: word-wrap;
        }
        if root.bench-ask: Text {
            text: "Usually under a minute, longer on a slow PC. Stop Read Aloud first — the test and Kindle share one synthesizer.";
            font-size: 13px;
            color: #a0a0a0;
            wrap: word-wrap;
        }
        if root.bench-ask: HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button { text: "Run test"; primary: true; clicked => { root.bench-start(); } }
            Button { text: "Cancel"; clicked => { root.bench-close(); } }
        }

        // Running. Indeterminate by necessity: how long a machine takes to synthesize
        // is the very thing being measured, so there's no honest percentage to show.
        if root.bench-running: Text { text: root.bench-phase; font-size: 14px; wrap: word-wrap; }
        if root.bench-running: ProgressIndicator { indeterminate: true; height: 6px; }
        if root.bench-running: HorizontalLayout {
            alignment: end;
            // Stop takes effect between engines: the engine being timed has to finish
            // its run before the synthesizer is free again.
            Button { text: "Stop"; clicked => { root.bench-stop(); } }
        }

        // Results.
        if root.bench-done: BenchRow {
            label: "Graphics card (GPU)";
            value: root.bench-gpu-text;
            won: root.bench-gpu-wins;
        }
        if root.bench-done: BenchRow {
            label: "Processor (CPU)";
            value: root.bench-cpu-text;
            won: root.bench-cpu-wins;
        }
        if root.bench-done: Text {
            text: "Higher is better. Below 1x, synthesis is slower than the speech it produces, so reading pauses to catch up.";
            font-size: 12px;
            color: #a0a0a0;
            wrap: word-wrap;
        }
        if root.bench-done: Text { text: root.bench-verdict; font-size: 14px; wrap: word-wrap; }
        if root.bench-done: HorizontalLayout {
            alignment: end;
            Button { text: "Close"; primary: true; clicked => { root.bench-close(); } }
        }
    }
}
