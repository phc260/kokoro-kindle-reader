{
  "name": "kokoro-kindle-reader-extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:capture": "bun run test/capture.check.ts",
    "bench:ocr": "bun run test/ocr-bench.ts",
    "test:ext": "bun run test/ext-ocr.check.ts",
    "make-key": "bun run scripts/make-key.ts",
    "stage": "bun run build.ts --stage"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/chrome": "^0.0.268",
    "puppeteer-core": "^23.0.0",
    "typescript": "^5.5.0"
  }
}