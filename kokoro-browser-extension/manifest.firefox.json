{
  "manifest_version": 3,
  "name": "Kokoro Kindle Reader",
  "version": "0.3.3",
  "description": "Reads Kindle Cloud Reader aloud: captures the rendered page, OCRs it locally, and narrates it. No text leaves your machine.",
  "icons": {
    "32": "icons/32x32.png",
    "128": "icons/128x128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kokoro-web-reader@phc260",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/*"
      ],
      "js": [
        "net-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://read.amazon.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "main-world.js",
        "vendor/*"
      ],
      "matches": [
        "https://read.amazon.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://read.amazon.com/*",
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
