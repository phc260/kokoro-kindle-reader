icons/* filter=lfs diff=lfs merge=lfs -text
# The icon master is text — keep it diffable, out of LFS.
icons/*.svg !filter !diff !merge text
# cargo-about's clarification hash is byte-exact, unlike the normalized text inventory.
licenses/dasp_sample-MIT.txt text eol=lf
# Shell scripts must keep LF whatever the checkout policy is. core.autocrlf=true would
# otherwise hand a Windows clone CRLF copies, and bash rejects those at the shebang
# ("bad interpreter: /usr/bin/env bash^M") - on Linux, from a tree that looks fine here.
*.sh text eol=lf
# LF for Python is not about the shebang: every .py is mode 100644 and started as
# `python <script>.py`, which reads CRLF fine. It is so the corresponding-source archive,
# which copies working-tree bytes, ships the same scripts whatever core.autocrlf the
# release was built under. (build-espeak.py's recorded digest normalizes and needs no pin.)
*.py text eol=lf
# The Material Symbols compiled into kokoro-panel.exe are pinned BYTE-EXACT in
# packaging/components.toml, so their checkout must not depend on core.autocrlf. Four of
# the five digests had been recorded from CRLF-smudged copies and one from LF, so the
# check passed only on the machine that recorded them. Same reason as dasp_sample-MIT.txt;
# the normalized inventories (license-texts.sha256) need no such pin.
kokoro-panel/ui/*.svg text eol=lf
# The reverse for batch files: cmd.exe parses LF-only scripts unreliably (labels and
# lines straddling its 512-byte read buffer), so they keep CRLF on every checkout.
*.cmd text eol=crlf
# The doctors' shared tool list. doctor.sh reads it with `IFS='|' read`, so a CR would end up
# inside the last field (the Linux fix); batch's for /f reads LF fine.
doctors/tools.conf text eol=lf
