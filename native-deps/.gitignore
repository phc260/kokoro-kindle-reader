# Downloaded / built third-party artifacts (re-created by fetch-deps.py on either platform).
espeak-ng-src/
espeak-ng-notices/
onnxruntime/
# One runtime tree per build family (fetch-deps.py): windows/, debian/, arch/, or another
# distribution's os-release ID. Kept apart so systems sharing this checkout never mix their
# libraries; matched by shape, since the families are not a closed list.
/*/runtime/
# The old shared Linux tree; fetch-deps.py no longer reads it and says so.
linux/
# The Windows tree's old location; fetch-deps.py moves it to windows/runtime/ on its next run.
/runtime/
# The pinned OCR models, 9.80 MB, re-created by fetch-ocr-models.py. Their digests live in
# kokoro-ocr/src/lib.rs and in that script, so what is committed is the pin, not the weights.
ocr/
# Build output
build/
# Python bytecode from the provisioning recipe.
__pycache__/
